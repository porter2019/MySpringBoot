SET NAMES utf8mb4;
-- Database setup
CREATE DATABASE IF NOT EXISTS `my_spring_boot` CHARACTER SET utf8mb4 COLLATE utf8mb4_0900_ai_ci;
USE `my_spring_boot`;

SET FOREIGN_KEY_CHECKS = 0;

DROP TABLE IF EXISTS `contract`;

CREATE TABLE `contract` (
  `id` bigint NOT NULL AUTO_INCREMENT COMMENT '主键自增id',
  `code` varchar(30) DEFAULT NULL COMMENT '合同编号',
  `name` varchar(30) DEFAULT NULL COMMENT '名称',
  `c_type` int NOT NULL DEFAULT '1' COMMENT '合同类型',
  `sign_date` datetime DEFAULT NULL COMMENT '签订时间',
  `value` decimal(19,4) DEFAULT NULL COMMENT '金额',
  `region_province` varchar(50) DEFAULT NULL COMMENT '省份',
  `region_city` varchar(50) DEFAULT NULL COMMENT '城市',
  `region_district` varchar(50) DEFAULT NULL COMMENT '地区',
  `region_full` varchar(200) DEFAULT NULL COMMENT '省市区',
  `region_address` varchar(200) DEFAULT NULL COMMENT '详细地址',
  `flag` int NOT NULL DEFAULT '0' COMMENT '审批状态',
  `status` tinyint(1) NOT NULL DEFAULT '1' COMMENT '状态',
  `remark` varchar(200) DEFAULT NULL COMMENT '备注',
  `created_user_id` bigint DEFAULT NULL COMMENT '创建者用户Id',
  `created_user_name` varchar(30) DEFAULT NULL COMMENT '创建者用户名',
  `created_time` datetime NOT NULL DEFAULT CURRENT_TIMESTAMP COMMENT '创建时间',
  `updated_user_id` bigint DEFAULT NULL COMMENT '更新者用户Id',
  `updated_user_name` varchar(30) DEFAULT NULL COMMENT '更新者用户名',
  `updated_time` datetime NOT NULL DEFAULT CURRENT_TIMESTAMP COMMENT '更新时间',
  `is_deleted` tinyint(1) NOT NULL DEFAULT '0' COMMENT '软删除',
  PRIMARY KEY (`id`)
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_0900_ai_ci COMMENT='合同';

DROP TABLE IF EXISTS `contract_item`;

CREATE TABLE `contract_item` (
  `id` bigint NOT NULL AUTO_INCREMENT COMMENT '主键自增id',
  `contract_id` bigint NOT NULL COMMENT '合同Id',
  `name` varchar(50) DEFAULT NULL COMMENT '名称',
  `price` decimal(19,4) DEFAULT NULL COMMENT '单价',
  `amount` decimal(19,4) DEFAULT NULL COMMENT '数量',
  `value` decimal(19,4) DEFAULT NULL COMMENT '金额',
  `remark` varchar(200) DEFAULT NULL COMMENT '备注',
  `sort` int NOT NULL DEFAULT '0' COMMENT '排序数字',
  `created_time` datetime NOT NULL DEFAULT CURRENT_TIMESTAMP COMMENT '创建时间',
  `updated_time` datetime NOT NULL DEFAULT CURRENT_TIMESTAMP COMMENT '更新时间',
  `is_deleted` tinyint(1) NOT NULL DEFAULT '0' COMMENT '软删除',
  PRIMARY KEY (`id`)
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_0900_ai_ci COMMENT='合同明细';

DROP TABLE IF EXISTS `log_action`;

CREATE TABLE `log_action` (
  `id` bigint NOT NULL AUTO_INCREMENT COMMENT '主键自增id',
  `client_type` int NOT NULL DEFAULT '0' COMMENT '客户端类型',
  `type` int NOT NULL DEFAULT '0' COMMENT '操作类型',
  `operator` varchar(30) DEFAULT NULL COMMENT '操作人',
  `class_name` varchar(200) DEFAULT NULL COMMENT '实体包名',
  `local` varchar(200) DEFAULT NULL COMMENT '位置',
  `content` mediumint DEFAULT NULL COMMENT '操作内容',
  `created_time` datetime NOT NULL DEFAULT CURRENT_TIMESTAMP COMMENT '创建时间',
  PRIMARY KEY (`id`)
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_0900_ai_ci COMMENT='操作日志';

DROP TABLE IF EXISTS `log_login`;

CREATE TABLE `log_login` (
  `id` bigint NOT NULL AUTO_INCREMENT COMMENT '主键自增id',
  `client_type` int NOT NULL DEFAULT '0' COMMENT '客户端类型',
  `user_id` bigint NOT NULL COMMENT '用户id',
  `user_name` varchar(30) DEFAULT NULL COMMENT '用户名',
  `cell_phone` varchar(20) DEFAULT NULL COMMENT '手机号',
  `platform` varchar(30) DEFAULT NULL COMMENT '登录平台',
  `ip` varchar(30) DEFAULT NULL COMMENT 'IP',
  `user_agent` varchar(500) DEFAULT NULL COMMENT 'UA',
  `created_time` datetime NOT NULL DEFAULT CURRENT_TIMESTAMP COMMENT '创建时间',
  PRIMARY KEY (`id`)
) ENGINE=InnoDB AUTO_INCREMENT=4 DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_0900_ai_ci COMMENT='登陆日志';

DROP TABLE IF EXISTS `sys_directory_category`;

CREATE TABLE `sys_directory_category` (
  `id` bigint NOT NULL AUTO_INCREMENT COMMENT '主键自增id',
  `name` varchar(50) DEFAULT NULL COMMENT '名称',
  `code` varchar(30) DEFAULT NULL COMMENT '负责人名称',
  `order_no` varchar(2000) DEFAULT NULL COMMENT '排序数字',
  `parent_id` bigint DEFAULT NULL COMMENT '父级id',
  `parent_name` varchar(50) DEFAULT NULL COMMENT '父级名称',
  `full_id` varchar(2000) DEFAULT NULL COMMENT '完整Id',
  `full_name` varchar(2000) DEFAULT NULL COMMENT '完整名称',
  `full_order_no` varchar(2000) DEFAULT NULL COMMENT '完整类别层级排序',
  `level_no` int DEFAULT NULL COMMENT '层级',
  `status` tinyint(1) NOT NULL DEFAULT '1' COMMENT '状态',
  `remark` varchar(200) DEFAULT NULL COMMENT '备注',
  `created_user_id` bigint DEFAULT NULL COMMENT '创建者用户Id',
  `created_user_name` varchar(30) DEFAULT NULL COMMENT '创建者用户名',
  `created_time` datetime NOT NULL DEFAULT CURRENT_TIMESTAMP COMMENT '创建时间',
  `updated_user_id` bigint DEFAULT NULL COMMENT '更新者用户Id',
  `updated_user_name` varchar(30) DEFAULT NULL COMMENT '更新者用户名',
  `updated_time` datetime NOT NULL DEFAULT CURRENT_TIMESTAMP COMMENT '更新时间',
  `is_deleted` tinyint(1) NOT NULL DEFAULT '0' COMMENT '软删除',
  PRIMARY KEY (`id`)
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_0900_ai_ci COMMENT='字典类别';

DROP TABLE IF EXISTS `sys_directory_item`;

CREATE TABLE `sys_directory_item` (
  `id` bigint NOT NULL AUTO_INCREMENT COMMENT '主键自增id',
  `category_id` bigint NOT NULL COMMENT '分类Id',
  `name` varchar(30) DEFAULT NULL COMMENT '名称',
  `value` varchar(30) DEFAULT NULL COMMENT '值',
  `status` tinyint(1) NOT NULL DEFAULT '1' COMMENT '状态',
  `remark` varchar(200) DEFAULT NULL COMMENT '备注',
  `created_user_id` bigint DEFAULT NULL COMMENT '创建者用户Id',
  `created_user_name` varchar(30) DEFAULT NULL COMMENT '创建者用户名',
  `created_time` datetime NOT NULL DEFAULT CURRENT_TIMESTAMP COMMENT '创建时间',
  `updated_user_id` bigint DEFAULT NULL COMMENT '更新者用户Id',
  `updated_user_name` varchar(30) DEFAULT NULL COMMENT '更新者用户名',
  `updated_time` datetime NOT NULL DEFAULT CURRENT_TIMESTAMP COMMENT '更新时间',
  `is_deleted` tinyint(1) NOT NULL DEFAULT '0' COMMENT '软删除',
  PRIMARY KEY (`id`)
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_0900_ai_ci COMMENT='字典项';

DROP TABLE IF EXISTS `sys_handler`;

CREATE TABLE `sys_handler` (
  `id` bigint NOT NULL AUTO_INCREMENT COMMENT '主键自增id',
  `module_id` bigint NOT NULL COMMENT '所属模块Id',
  `handler_name` varchar(50) DEFAULT NULL COMMENT '模块名称',
  `alias_name` varchar(50) DEFAULT NULL COMMENT '功能别名',
  `ref_controller` varchar(500) DEFAULT NULL COMMENT '关联控制器',
  `sort` int NOT NULL DEFAULT '0' COMMENT '排序数字',
  `created_time` datetime NOT NULL DEFAULT CURRENT_TIMESTAMP COMMENT '创建时间',
  `updated_time` datetime NOT NULL DEFAULT CURRENT_TIMESTAMP COMMENT '更新时间',
  `is_deleted` tinyint(1) NOT NULL DEFAULT '0' COMMENT '软删除',
  PRIMARY KEY (`id`)
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_0900_ai_ci COMMENT='模块下的功能';

DROP TABLE IF EXISTS `sys_module`;

CREATE TABLE `sys_module` (
  `id` bigint NOT NULL AUTO_INCREMENT COMMENT '主键自增id',
  `module_name` varchar(50) DEFAULT NULL COMMENT '模块名称',
  `sort` int NOT NULL DEFAULT '0' COMMENT '排序数字',
  `created_time` datetime NOT NULL DEFAULT CURRENT_TIMESTAMP COMMENT '创建时间',
  `updated_time` datetime NOT NULL DEFAULT CURRENT_TIMESTAMP COMMENT '更新时间',
  `is_deleted` tinyint(1) NOT NULL DEFAULT '0' COMMENT '软删除',
  PRIMARY KEY (`id`)
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_0900_ai_ci COMMENT='系统模块';

DROP TABLE IF EXISTS `sys_org`;

CREATE TABLE `sys_org` (
  `id` bigint NOT NULL AUTO_INCREMENT COMMENT '主键自增id',
  `name` varchar(50) DEFAULT NULL COMMENT '名称',
  `leader_id` bigint DEFAULT NULL COMMENT '负责人Id',
  `leader_name` varchar(30) DEFAULT NULL COMMENT '负责人名称',
  `order_no` varchar(2000) DEFAULT NULL COMMENT '排序数字',
  `parent_id` bigint DEFAULT NULL COMMENT '父级id',
  `parent_name` varchar(50) DEFAULT NULL COMMENT '父级名称',
  `full_id` varchar(2000) DEFAULT NULL COMMENT '完整Id',
  `full_name` varchar(2000) DEFAULT NULL COMMENT '完整名称',
  `full_order_no` varchar(2000) DEFAULT NULL COMMENT '完整类别层级排序',
  `level_no` int DEFAULT NULL COMMENT '层级',
  `status` tinyint(1) NOT NULL DEFAULT '1' COMMENT '状态',
  `remark` varchar(200) DEFAULT NULL COMMENT '备注',
  `created_user_id` bigint DEFAULT NULL COMMENT '创建者用户Id',
  `created_user_name` varchar(30) DEFAULT NULL COMMENT '创建者用户名',
  `created_time` datetime NOT NULL DEFAULT CURRENT_TIMESTAMP COMMENT '创建时间',
  `updated_user_id` bigint DEFAULT NULL COMMENT '更新者用户Id',
  `updated_user_name` varchar(30) DEFAULT NULL COMMENT '更新者用户名',
  `updated_time` datetime NOT NULL DEFAULT CURRENT_TIMESTAMP COMMENT '更新时间',
  `is_deleted` tinyint(1) NOT NULL DEFAULT '0' COMMENT '软删除',
  PRIMARY KEY (`id`)
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_0900_ai_ci COMMENT='部门';

DROP TABLE IF EXISTS `sys_permit`;

CREATE TABLE `sys_permit` (
  `id` bigint NOT NULL AUTO_INCREMENT COMMENT '主键自增id',
  `handler_id` bigint NOT NULL COMMENT '所属功能Id',
  `permit_name` varchar(50) DEFAULT NULL COMMENT '模块名称',
  `alias_name` varchar(50) DEFAULT NULL COMMENT '功能别名',
  `created_time` datetime NOT NULL DEFAULT CURRENT_TIMESTAMP COMMENT '创建时间',
  `updated_time` datetime NOT NULL DEFAULT CURRENT_TIMESTAMP COMMENT '更新时间',
  `is_deleted` tinyint(1) NOT NULL DEFAULT '0' COMMENT '软删除',
  PRIMARY KEY (`id`)
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_0900_ai_ci COMMENT='功能下的权限';

DROP TABLE IF EXISTS `sys_post`;

CREATE TABLE `sys_post` (
  `id` bigint NOT NULL AUTO_INCREMENT COMMENT '主键自增id',
  `code` varchar(50) DEFAULT NULL COMMENT '岗位编码',
  `name` varchar(30) DEFAULT NULL COMMENT '岗位名称',
  `sort` int NOT NULL DEFAULT '0' COMMENT '排序数字',
  `status` tinyint(1) NOT NULL DEFAULT '1' COMMENT '状态',
  `remark` varchar(200) DEFAULT NULL COMMENT '备注',
  `created_user_id` bigint DEFAULT NULL COMMENT '创建者用户Id',
  `created_user_name` varchar(30) DEFAULT NULL COMMENT '创建者用户名',
  `created_time` datetime NOT NULL DEFAULT CURRENT_TIMESTAMP COMMENT '创建时间',
  `updated_user_id` bigint DEFAULT NULL COMMENT '更新者用户Id',
  `updated_user_name` varchar(30) DEFAULT NULL COMMENT '更新者用户名',
  `updated_time` datetime NOT NULL DEFAULT CURRENT_TIMESTAMP COMMENT '更新时间',
  `is_deleted` tinyint(1) NOT NULL DEFAULT '0' COMMENT '软删除',
  PRIMARY KEY (`id`)
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_0900_ai_ci COMMENT='岗位';

DROP TABLE IF EXISTS `sys_post_user`;

CREATE TABLE `sys_post_user` (
  `id` bigint NOT NULL AUTO_INCREMENT COMMENT '主键自增id',
  `post_id` bigint NOT NULL COMMENT '岗位Id',
  `user_id` bigint NOT NULL COMMENT '用户Id',
  `created_time` datetime NOT NULL DEFAULT CURRENT_TIMESTAMP COMMENT '创建时间',
  `updated_time` datetime NOT NULL DEFAULT CURRENT_TIMESTAMP COMMENT '更新时间',
  `is_deleted` tinyint(1) NOT NULL DEFAULT '0' COMMENT '软删除',
  PRIMARY KEY (`id`)
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_0900_ai_ci COMMENT='岗位下的用户';

DROP TABLE IF EXISTS `sys_role`;

CREATE TABLE `sys_role` (
  `id` bigint NOT NULL AUTO_INCREMENT COMMENT '主键自增id',
  `name` varchar(30) DEFAULT NULL COMMENT '岗位名称',
  `sort` int NOT NULL DEFAULT '0' COMMENT '排序数字',
  `is_super` tinyint(1) NOT NULL DEFAULT '0' COMMENT '是否超级管理组',
  `status` tinyint(1) NOT NULL DEFAULT '1' COMMENT '状态',
  `remark` varchar(200) DEFAULT NULL COMMENT '备注',
  `created_user_id` bigint DEFAULT NULL COMMENT '创建者用户Id',
  `created_user_name` varchar(30) DEFAULT NULL COMMENT '创建者用户名',
  `created_time` datetime NOT NULL DEFAULT CURRENT_TIMESTAMP COMMENT '创建时间',
  `updated_user_id` bigint DEFAULT NULL COMMENT '更新者用户Id',
  `updated_user_name` varchar(30) DEFAULT NULL COMMENT '更新者用户名',
  `updated_time` datetime NOT NULL DEFAULT CURRENT_TIMESTAMP COMMENT '更新时间',
  `is_deleted` tinyint(1) NOT NULL DEFAULT '0' COMMENT '软删除',
  PRIMARY KEY (`id`)
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_0900_ai_ci COMMENT='角色';

DROP TABLE IF EXISTS `sys_role_permit`;

CREATE TABLE `sys_role_permit` (
  `id` bigint NOT NULL AUTO_INCREMENT COMMENT '主键自增id',
  `role_id` bigint NOT NULL COMMENT '角色Id',
  `permit_id` bigint NOT NULL COMMENT '权限Id',
  `created_time` datetime NOT NULL DEFAULT CURRENT_TIMESTAMP COMMENT '创建时间',
  `updated_time` datetime NOT NULL DEFAULT CURRENT_TIMESTAMP COMMENT '更新时间',
  `is_deleted` tinyint(1) NOT NULL DEFAULT '0' COMMENT '软删除',
  PRIMARY KEY (`id`)
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_0900_ai_ci COMMENT='角色所拥有的权限';

DROP TABLE IF EXISTS `sys_role_user`;

CREATE TABLE `sys_role_user` (
  `id` bigint NOT NULL AUTO_INCREMENT COMMENT '主键自增id',
  `role_id` bigint NOT NULL COMMENT '角色Id',
  `user_id` bigint NOT NULL COMMENT '用户Id',
  `created_time` datetime NOT NULL DEFAULT CURRENT_TIMESTAMP COMMENT '创建时间',
  `updated_time` datetime NOT NULL DEFAULT CURRENT_TIMESTAMP COMMENT '更新时间',
  `is_deleted` tinyint(1) NOT NULL DEFAULT '0' COMMENT '软删除',
  PRIMARY KEY (`id`)
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_0900_ai_ci COMMENT='角色下的用户';

DROP TABLE IF EXISTS `sys_user`;

CREATE TABLE `sys_user` (
  `id` bigint NOT NULL AUTO_INCREMENT COMMENT '主键自增id',
  `cell_phone` varchar(20) DEFAULT NULL COMMENT '手机号',
  `login_name` varchar(30) DEFAULT NULL COMMENT '登陆名',
  `user_name` varchar(30) DEFAULT NULL COMMENT '用户名',
  `gender` varchar(20) DEFAULT NULL COMMENT '性别',
  `email` varchar(50) DEFAULT NULL COMMENT '邮箱',
  `password` varchar(500) DEFAULT NULL COMMENT '密码',
  `org_id` bigint DEFAULT NULL COMMENT '部门Id',
  `org_name` varchar(50) DEFAULT NULL COMMENT '部门名称',
  `is_om` tinyint(1) NOT NULL DEFAULT '1' COMMENT '运营系统管理权限',
  `is_mp` tinyint(1) NOT NULL DEFAULT '1' COMMENT '移动端登录权限',
  `is_super` tinyint(1) NOT NULL DEFAULT '0' COMMENT '是否超管',
  `avatar` varchar(500) DEFAULT NULL COMMENT '头像',
  `wx_mp_open_id` varchar(50) DEFAULT NULL COMMENT '微信公众号的OpenId',
  `last_login_time` datetime DEFAULT NULL COMMENT '最后登陆时间',
  `last_login_ip` varchar(50) DEFAULT NULL COMMENT '最后登录IP',
  `status` tinyint(1) NOT NULL DEFAULT '1' COMMENT '状态',
  `remark` varchar(200) DEFAULT NULL COMMENT '备注',
  `created_user_id` bigint DEFAULT NULL COMMENT '创建者用户Id',
  `created_user_name` varchar(30) DEFAULT NULL COMMENT '创建者用户名',
  `created_time` datetime NOT NULL DEFAULT CURRENT_TIMESTAMP COMMENT '创建时间',
  `updated_user_id` bigint DEFAULT NULL COMMENT '更新者用户Id',
  `updated_user_name` varchar(30) DEFAULT NULL COMMENT '更新者用户名',
  `updated_time` datetime NOT NULL DEFAULT CURRENT_TIMESTAMP COMMENT '更新时间',
  `is_deleted` tinyint(1) NOT NULL DEFAULT '0' COMMENT '软删除',
  PRIMARY KEY (`id`)
) ENGINE=InnoDB AUTO_INCREMENT=2 DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_0900_ai_ci COMMENT='系统用户';

DROP TABLE IF EXISTS `tree`;

CREATE TABLE `tree` (
  `id` bigint NOT NULL AUTO_INCREMENT COMMENT '主键自增id',
  `code` varchar(50) DEFAULT NULL COMMENT '标识',
  `name` varchar(50) DEFAULT NULL COMMENT '名称',
  `order_no` varchar(2000) DEFAULT NULL COMMENT '排序数字',
  `parent_id` bigint DEFAULT NULL COMMENT '父级id',
  `parent_name` varchar(50) DEFAULT NULL COMMENT '父级名称',
  `full_id` varchar(2000) DEFAULT NULL COMMENT '完整Id',
  `full_name` varchar(2000) DEFAULT NULL COMMENT '完整名称',
  `full_order_no` varchar(2000) DEFAULT NULL COMMENT '完整类别层级排序',
  `level_no` int DEFAULT NULL COMMENT '层级',
  `status` tinyint(1) NOT NULL DEFAULT '1' COMMENT '状态',
  `remark` varchar(200) DEFAULT NULL COMMENT '备注',
  `created_user_id` mediumtext COMMENT '创建者用户Id',
  `created_user_name` varchar(30) DEFAULT NULL COMMENT '创建者用户名',
  `created_time` datetime NOT NULL DEFAULT CURRENT_TIMESTAMP COMMENT '创建时间',
  `updated_user_id` mediumtext COMMENT '更新者用户Id',
  `updated_user_name` varchar(30) DEFAULT NULL COMMENT '更新者用户名',
  `updated_time` datetime NOT NULL DEFAULT CURRENT_TIMESTAMP COMMENT '更新时间',
  `is_deleted` tinyint(1) NOT NULL DEFAULT '0' COMMENT '软删除',
  PRIMARY KEY (`id`)
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_0900_ai_ci COMMENT='树形数据';

DROP VIEW IF EXISTS `sys_directory_item_full_view`;
CREATE ALGORITHM=UNDEFINED SQL SECURITY DEFINER VIEW `sys_directory_item_full_view` AS select `a`.`id` AS `id`,`a`.`category_id` AS `category_id`,`a`.`name` AS `name`,`a`.`value` AS `value`,`a`.`status` AS `status`,`a`.`remark` AS `remark`,`a`.`created_user_id` AS `created_user_id`,`a`.`created_user_name` AS `created_user_name`,`a`.`created_time` AS `created_time`,`a`.`updated_user_id` AS `updated_user_id`,`a`.`updated_user_name` AS `updated_user_name`,`a`.`updated_time` AS `updated_time`,`a`.`is_deleted` AS `is_deleted`,`sdc`.`name` AS `category_name`,`sdc`.`code` AS `category_code` from (`sys_directory_item` `a` left join `sys_directory_category` `sdc` on(((`a`.`category_id` = `sdc`.`id`) and (`sdc`.`is_deleted` = 0)))) where (`a`.`is_deleted` = 0) group by `a`.`id`;

DROP VIEW IF EXISTS `sys_user_om_view`;
CREATE ALGORITHM=UNDEFINED SQL SECURITY DEFINER VIEW `sys_user_om_view` AS select `a`.`id` AS `id`,`a`.`cell_phone` AS `cell_phone`,`a`.`login_name` AS `login_name`,`a`.`user_name` AS `user_name`,`a`.`email` AS `email`,`a`.`password` AS `password`,`a`.`org_id` AS `org_id`,`a`.`org_name` AS `org_name`,`a`.`is_om` AS `is_om`,`a`.`is_mp` AS `is_mp`,`a`.`is_supper` AS `is_supper`,`a`.`avatar` AS `avatar`,`a`.`wx_mp_open_id` AS `wx_mp_open_id`,`a`.`last_login_time` AS `last_login_time`,`a`.`last_login_ip` AS `last_login_ip`,`a`.`status` AS `status`,`a`.`remark` AS `remark`,`a`.`created_user_id` AS `created_user_id`,`a`.`created_user_name` AS `created_user_name`,`a`.`created_time` AS `created_time`,`a`.`updated_user_id` AS `updated_user_id`,`a`.`updated_user_name` AS `updated_user_name`,`a`.`updated_time` AS `updated_time`,`a`.`is_deleted` AS `is_deleted`,ifnull(group_concat(`ru`.`role_id` separator ','),'') AS `role_ids`,ifnull(group_concat(`sr`.`name` separator ','),'') AS `role_names`,ifnull(group_concat(`spu`.`post_id` separator ','),'') AS `post_ids`,ifnull(group_concat(`sp`.`name` separator ','),'') AS `post_names` from ((((`sys_user` `a` left join `sys_role_user` `ru` on(((`a`.`id` = `ru`.`user_id`) and (`ru`.`is_deleted` = 0)))) left join `sys_role` `sr` on(((`sr`.`id` = `ru`.`role_id`) and (`sr`.`is_deleted` = 0)))) left join `sys_post_user` `spu` on(((`a`.`id` = `spu`.`user_id`) and (`spu`.`is_deleted` = 0)))) left join `sys_post` `sp` on(((`sp`.`id` = `spu`.`post_id`) and (`sp`.`is_deleted` = 0)))) where (`a`.`is_deleted` = 0) group by `a`.`id`;

DROP PROCEDURE IF EXISTS `sp_update_sys_org_layer`;
DELIMITER //
CREATE PROCEDURE `sp_update_sys_org_layer`()
BEGIN
    -- 使用递归CTE来构建层级结构
    WITH RECURSIVE p AS (
        SELECT
            a.id,
            a.name,
            a.order_no,
            CAST('' AS CHAR(255)) AS parent_name,  -- 显式定义初始长度
            CAST(CONCAT('|', a.id, '|') AS CHAR(1000)) AS full_id,
            a.name AS full_name,
            1 AS level_no,
            a.order_no AS full_order_no
        FROM sys_org a
        WHERE a.parent_id = 0 and a.is_deleted = 0
        UNION ALL
        SELECT
            a.id,
            a.`name`,
            a.order_no,
            CAST(p.`name` AS CHAR(255)) AS parent_name,
            CAST(LEFT(CONCAT(p.full_id, a.id, '|'), 1000) AS CHAR(1000)) AS full_id,
            CAST(LEFT(CONCAT(p.full_name, '|', a.name), 1000) AS CHAR(1000)) AS full_name,
            (p.level_no + 1) AS level_no,
            LEFT(CONCAT(p.full_order_no, '|', a.order_no),2000) AS full_order_no
        FROM sys_org a
                 INNER JOIN p ON a.parent_id = p.id where a.is_deleted = 0
    )
    -- 更新Tree表中的层级信息
    UPDATE sys_org q
        INNER JOIN p ON q.id = p.id
    SET
        q.parent_name = p.parent_name,
        q.full_id = LEFT(p.full_id, 1000),       -- 在赋值时再次截断，保险
        q.full_name = LEFT(p.full_name, 1000),
        q.level_no = p.level_no,
        q.full_order_no = LEFT(p.full_order_no, 1000);
END//
DELIMITER ;

DROP PROCEDURE IF EXISTS `sp_update_tree_layer`;
DELIMITER //
CREATE PROCEDURE `sp_update_tree_layer`()
BEGIN
    -- 使用递归CTE来构建层级结构
    WITH RECURSIVE p AS (
        SELECT
            a.id,
            a.name,
            a.order_no,
            CAST('' AS CHAR(255)) AS parent_name,  -- 显式定义初始长度
            CAST(CONCAT('|', a.id, '|') AS CHAR(1000)) AS full_id,
            a.name AS full_name,
            1 AS level_no,
            a.order_no AS full_order_no
        FROM Tree a
        WHERE a.parent_id = 0 and a.is_deleted = 0
        UNION ALL
        SELECT
            a.id,
            a.`name`,
            a.order_no,
            CAST(p.`name` AS CHAR(255)) AS parent_name,
            CAST(LEFT(CONCAT(p.full_id, a.id, '|'), 1000) AS CHAR(1000)) AS full_id,
            CAST(LEFT(CONCAT(p.full_name, '|', a.name), 1000) AS CHAR(1000)) AS full_name,
            (p.level_no + 1) AS level_no,
            LEFT(CONCAT(p.full_order_no, '|', a.order_no),2000) AS full_order_no
        FROM Tree a
                 INNER JOIN p ON a.parent_id = p.id where a.is_deleted = 0
    )
    -- 更新Tree表中的层级信息
    UPDATE Tree q
        INNER JOIN p ON q.id = p.id
    SET
        q.parent_name = p.parent_name,
        q.full_id = LEFT(p.full_id, 1000),       -- 在赋值时再次截断，保险
        q.full_name = LEFT(p.full_name, 1000),
        q.level_no = p.level_no,
        q.full_order_no = LEFT(p.full_order_no, 1000);
END//
DELIMITER ;

SET FOREIGN_KEY_CHECKS = 1;
