-- comment on column sys_user_om_view.is_super not supported: 是否超管

-- comment on column sys_user_om_view.avatar not supported: 头像

-- comment on column sys_user_om_view.wx_mp_open_id not supported: 微信公众号的OpenId

-- comment on column sys_user_om_view.last_login_time not supported: 最后登录时间

-- comment on column sys_user_om_view.status not supported: 状态

-- comment on column sys_user_om_view.remark not supported: 备注

-- comment on column sys_user_om_view.created_user_id not supported: 创建者用户Id

-- comment on column sys_user_om_view.created_user_name not supported: 创建者用户名

-- comment on column sys_user_om_view.created_time not supported: 创建时间

-- comment on column sys_user_om_view.updated_user_id not supported: 更新者用户Id

-- comment on column sys_user_om_view.updated_user_name not supported: 更新者用户名

-- comment on column sys_user_om_view.updated_time not supported: 更新时间

-- comment on column sys_user_om_view.is_deleted not supported: 软删除

create procedure sp_update_tree_layer()
BEGIN
    -- 使用递归CTE来构建层级结构
    WITH RECURSIVE p AS (
        SELECT
            a.id,
            a.name,
            a.order_no,
            CAST('' AS CHAR(255)) AS parent_name,  -- 显式定义初始长度
            CAST(CONCAT('|', a.id, '|') AS CHAR(1000)) AS full_id,
            a.name AS full_name,
            1 AS level_no,
            a.order_no AS full_order_no
        FROM Tree a
        WHERE a.parent_id = 0 and a.is_deleted = 0
        UNION ALL
        SELECT
            a.id,
            a.`name`,
            a.order_no,
            CAST(p.`name` AS CHAR(255)) AS parent_name,
            CAST(LEFT(CONCAT(p.full_id, a.id, '|'), 1000) AS CHAR(1000)) AS full_id,
            CAST(LEFT(CONCAT(p.full_name, '|', a.name), 1000) AS CHAR(1000)) AS full_name,
            (p.level_no + 1) AS level_no,
            LEFT(CONCAT(p.full_order_no, '|', a.order_no),2000) AS full_order_no
        FROM Tree a
                 INNER JOIN p ON a.parent_id = p.id where a.is_deleted = 0
    )
    -- 更新Tree表中的层级信息
    UPDATE Tree q
        INNER JOIN p ON q.id = p.id
    SET
        q.parent_name = p.parent_name,
        q.full_id = LEFT(p.full_id, 1000),       -- 在赋值时再次截断，保险
        q.full_name = LEFT(p.full_name, 1000),
        q.level_no = p.level_no,
        q.full_order_no = LEFT(p.full_order_no, 1000);
END;

